# 复制为 .env 并填入你自己的值。不要把真实密钥粘贴到聊天、代码或提交中。
APP_ENV=development
LOG_LEVEL=INFO
# TRADING_MODE: paper(默认)/ testnet / live(真实资金)
TRADING_MODE=paper
# live 模式必须显式开启;paper/testnet 模式下为 true 会被启动拒绝
ENABLE_LIVE_TRADING=false
ENABLE_BINANCE_TESTNET=false

LLM_PRIMARY_BASE_URL=
LLM_PRIMARY_API_KEY=
LLM_SECONDARY_BASE_URL=
LLM_SECONDARY_API_KEY=
LLM_FAST_MODEL=
LLM_REASONING_MODEL=
LLM_BACKUP_MODEL=

BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Live 真实资金密钥(阶段 8,仅 TRADING_MODE=live 时使用):
# - 与 Testnet 密钥完全分开,禁止复用;
# - 只在正式账户 API 管理中创建,权限只勾选"现货交易",不要提现权限;
# - 只写在本地 .env,绝不粘贴到聊天/代码/提交。
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

# 交易所流量代理(可选):CCXT 不读系统代理,被墙网络需显式设置。
# 例:http://127.0.0.1:10808;留空 = 直连。
EXCHANGE_PROXY_URL=

# 数据库(阶段 7,可选):留空 = 不启用(仅本地 JSONL 审计)。
# PostgreSQL 示例;本地测试也可用 sqlite:///var/agent.db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/crypto_agent
REDIS_URL=redis://localhost:6379/0

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
